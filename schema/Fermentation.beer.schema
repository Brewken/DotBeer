{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/Fermentation.beer.schema",
  "type": "object",
  "additionalProperties": false,
  "Fermentation": {
    "type": "object",
    "description": "A fermentation procedure, which can be used by multiple recipes.",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "fermentation_description": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "fermentation_steps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "FermentationStep": {
            "type": "object",
            "description": "Individual step of a fermentation.",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "step_description": {
                "type": "string"
              },
              "start_temperature": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Temperature"
              },
              "end_temperature": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Temperature"
              },
              "step_time": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Time"
              },
              "free_rise": {
                "description": "Free rise is used to indicate a fermentation step where the exothermic fermentation is allowed to raise the temperature without restriction This is either True or false.",
                "type": "boolean"
              },
              "start_gravity": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Density"
              },
              "end_gravity": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Density"
              },
              "start_pH": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Acidity"
              },
              "end_pH": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Acidity"
              },
              "vessel": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "required": [
      "name",
      "fermentation_steps"
    ]
  }
}