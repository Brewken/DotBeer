{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/Mash.beer.schema",
  "type": "object",
  "additionalProperties": false,
  "Mash": {
    "type": "object",
    "description": "A mash procedure, which can be used by multiple recipes.",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "grain_temperature": {
        "description": "Initial grain temperature prior to the start of the mash.",
        "$ref": "Measurement.beer.schema#/PhysicalQuantity/Temperature"
      },
      "notes": {
        "type": "string"
      },
      "mash_steps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "MashStep": {
            "type": "object",
            "description": "Individual step of a mash.",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "step_type": {
                "enum": [
                  "infusion",
                  "temperature",
                  "decoction",
                  "souring mash",
                  "souring wort",
                  "drain mash tun",
                  "sparge"
                ]
              },
              "amount": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Volume"
              },
              "step_temperature": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Temperature"
              },
              "step_time": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Time"
              },
              "ramp_time": {
                "description": "The amount of time  that passes before this step begins. eg moving from a mash step (step 1) of 148F, to a new temperature step of 156F (step 2) may take 8 minutes to heat the mash. Step 2 would have a ramp time of 8 minutes.",
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Time"
              },
              "end_temperature": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Temperature"
              },
              "step_description": {
                "type": "string"
              },
              "water_grain_ratio": {
                "description": "Also known as the mash thickness. eg 1.75 qt/lb or 3.65 L/kg.",
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/SpecificVolume"
              },
              "infuse_temperature": {
                "description": "Temperature of the water for an infusion step.",
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Temperature"
              },
              "start_pH": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Acidity"
              },
              "end_pH": {
                "$ref": "Measurement.beer.schema#/PhysicalQuantity/Acidity"
              }
            },
            "required": [
              "name",
              "type",
              "step_temperature",
              "step_time"
            ]
          }
        }
      }
    },
    "required": [
      "name",
      "grain_temperature",
      "mash_steps"
    ]
  }
}