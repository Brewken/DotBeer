{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/Style.beer.schema",
  "type": "object",
  "description": "The full definition of a Style categorization",
  "allOf": [
    {
      "$ref": "#/$defs/StyleBase"
    },
    {
      "properties": {
        "original_gravity": {
          "$ref": "Measurement.beer.schema#/$defs/RangeOfDensity"
        },
        "final_gravity": {
          "$ref": "Measurement.beer.schema#/$defs/RangeOfDensity"
        },
        "international_bitterness_units": {
          "$ref": "Measurement.beer.schema#/$defs/RangeOfBitterness"
        },
        "color": {
          "$ref": "Measurement.beer.schema#/$defs/RangeOfColor"
        },
        "carbonation": {
          "$ref": "Measurement.beer.schema#/$defs/RangeOfCarbonation"
        },
        "alcohol_by_volume": {
          "$ref": "Measurement.beer.schema#/$defs/RangeOfPercentage"
        },
        "notes": {
          "type": "string"
        },
        "aroma": {
          "type": "string"
        },
        "appearance": {
          "type": "string"
        },
        "flavor": {
          "type": "string"
        },
        "mouthfeel": {
          "type": "string"
        },
        "overall_impression": {
          "type": "string"
        },
        "ingredients": {
          "type": "string"
        },
        "examples": {
          "type": "string"
        }
      }
    }
  ],
  "$defs": {
    "StyleBase": {
      "type": "object",
      "description": "The descriptive base type for both style guideline records, and recipe style provisions. Provides unique properties to identify individual styles",
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "category_number": {
          "type": "integer"
        },
        "style_letter": {
          "type": "string",
          "maxLength": 1,
          "minLength": 1,
          "pattern": "[A-Z ]"
        },
        "style_guide": {
          "type": "string"
        },
        "style_type": {
          "enum": [
            "beer",
            "cider",
            "kombucha",
            "mead",
            "other",
            "soda",
            "wine"
          ]
        }
      },
      "required": [
        "name",
        "category",
        "style_guide",
        "style_type"
      ]
    }
  }
}