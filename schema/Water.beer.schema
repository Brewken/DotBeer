{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/Water.beer.schema",
  "type": "object",
  "additionalProperties": false,
  "Water": {
    "Base": {
      "type": "object",
      "description": "Provides unique properties to identify individual records of brewing water.  NOTE that water is handled differently from other ingredients.  We don't model inventory of water, it doesn't have producers or product IDs, and the amounts needed in a recipe are already defined in its mash steps rather than by RecipeAddition amounts.",
      "properties": {
        "name": {
          "type": "string"
        },
        "calcium": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "bicarbonate": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "carbonate": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "potassium": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "iron": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "nitrate": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "nitrite": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "fluoride": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "sulfate": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "chloride": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "sodium": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        },
        "magnesium": {
          "$ref": "Measurement.beer.schema#/PhysicalQuantity/MassFractionOrConcentration"
        }
      },
      "required": [
        "name",
        "calcium",
        "bicarbonate",
        "sulfate",
        "chloride",
        "sodium",
        "magnesium"
      ]
    },
    "Full": {
      "type": "object",
      "description": "Full definition of a water profile.",
      "allOf": [
        {
          "$ref": "#/Water/Base"
        },
        {
          "properties": {
            "pH": {
              "$ref": "Measurement.beer.schema#/PhysicalQuantity/Acidity"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}